# Bitcoin Education Roleplay Environment Configuration
# Local-first defaults — leave blank to use Vite proxies to Ollama + backend.

# Ollama (dev proxy: /api → http://127.0.0.1:11434)
# For preview without Vite, use: http://127.0.0.1:11434/api
VITE_OLLAMA_URL=
VITE_OLLAMA_MODEL=llama3.2:3b
VITE_OLLAMA_TIMEOUT=300000

# Knowledge backend (dev proxy: /knowledge → http://127.0.0.1:3000)
VITE_BACKEND_URL=

VITE_CHAT_MAX_HISTORY=20
VITE_HEALTH_CHECK_INTERVAL=30000
VITE_MOBILE_BREAKPOINT=768
VITE_MAX_MESSAGE_LENGTH=1000
VITE_AVATAR_MODEL=kei
VITE_AVATAR_FALLBACK=true
